# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Optional: Cursor MCP — Google Developer Knowledge (official docs search)
# Create in Google Cloud: enable Developer Knowledge API, then create an API key
# restricted to that API. See README «MCP» section.
# Must be exported in the shell before starting Cursor, e.g.:
#   export DEVELOPER_KNOWLEDGE_API_KEY=your_gcp_key
DEVELOPER_KNOWLEDGE_API_KEY=

# Cloudflare R2 Storage (optional — video persistence)
# If configured, uploaded videos are stored in R2 and a video_url is returned in the response.
# If not configured, the app works as before (tempfile only).
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=visual-coach-videos
R2_PUBLIC_URL=
